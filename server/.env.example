# Copy this file to .env. Never commit .env.

# Neon PostgreSQL connection string. Leave empty to use the embedded local database.
DATABASE_URL=

# Required in production: at least 32 random characters.
JWT_SECRET=

PORT=4000

# --- AI model ---
# Default: Ollama on this computer. No key needed.
LLM_PROVIDER=ollama
LLM_BASE_URL=http://127.0.0.1:11434
LLM_MODEL=llama3.2:3b
EMBEDDING_MODEL=nomic-embed-text

# Cloud: any OpenAI-compatible API. Example values:
# LLM_PROVIDER=cloud
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# LLM_API_KEY=your-key-here
# LLM_MODEL=your-chat-model
# EMBEDDING_MODEL=your-embedding-model
